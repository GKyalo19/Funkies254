# Copy this file to `.env` in the same folder and fill in real values.
# Never commit the real `.env` file — it is already in .gitignore.

# --- Django core ---
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (Supabase Postgres connection string) ---
# Found in Supabase dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# --- Supabase Storage (for event cover images / user avatars) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=funkies254-media

# --- CORS / frontend origin(s) that are allowed to call this API with cookies ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- JWT cookie behaviour ---
# Set to True in production (Render/Netlify are both HTTPS). Keep False for plain http local dev.
JWT_COOKIE_SECURE=False

# --- Email (used for password reset links). Console backend just prints to terminal during dev. ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Funkies254 <no-reply@funkies254.com>

# --- Frontend URL (used to build password reset links) ---
FRONTEND_BASE_URL=http://127.0.0.1:5500
