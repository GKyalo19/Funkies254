# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored — never commit real secrets.

# --- Django core ---
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Africa/Nairobi

# --- Database ---
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Leave blank for local development and settings.py falls back to SQLite so you
# can run the server and the test suite immediately.
#   Local PostgreSQL:  postgres://funkies:funkies@127.0.0.1:5432/funkies254
#   Supabase pooler:   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=600

# --- Supabase Storage (event cover images and avatars) ---
# The service-role key is backend-only. Never expose it to the frontend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_BUCKET_EVENT_COVERS=event-covers
SUPABASE_BUCKET_AVATARS=avatars

# --- Upload limits ---
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- CORS / CSRF: frontend origins allowed to call this API with cookies ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- JWT cookie behaviour ---
# Production (Netlify -> Render is cross-site): Secure=True and SameSite=None.
# Local http development: Secure=False and SameSite=Lax.
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
# Require an X-CSRFToken header on cookie-authenticated writes.
# Keep False while testing with Postman; set True in production.
JWT_COOKIE_CSRF_ENFORCED=False

# --- Frontend ---
FRONTEND_BASE_URL=http://127.0.0.1:5500
