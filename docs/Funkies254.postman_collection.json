{
  "info": {
    "name": "Funkies254 API",
    "description": "Funkies254 backend (Django + DRF + Supabase).\n\nAuthentication uses httpOnly JWT cookies. Run 'Auth > Login (student)' first — Postman's cookie jar stores the cookies and replays them on every later request. Log in as a different demo account to switch roles.\n\nDemo accounts (after `python manage.py seed_demo_data`), all with password Funkies254!:\n- student@funkies254.test (student)\n- staff@funkies254.test (institution_staff)\n- admin@funkies254.test (admin)\n- superadmin@funkies254.test (super_admin)\n\nSeveral requests store ids into collection variables ({{event_id}}, {{event_slug}}, etc.) so the folders can be run in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "password", "value": "Funkies254!", "type": "string" },
    { "key": "event_id", "value": "", "type": "string" },
    { "key": "event_slug", "value": "", "type": "string" },
    { "key": "institution_slug", "value": "nairobi-high-school", "type": "string" },
    { "key": "category_id", "value": "", "type": "string" },
    { "key": "school_level_id", "value": "", "type": "string" },
    { "key": "institution_id", "value": "", "type": "string" },
    { "key": "registration_id", "value": "", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" },
    { "key": "csrf_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Health & reference data",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/health/", "host": ["{{base_url}}"], "path": ["api", "health", ""] }
          }
        },
        {
          "name": "List categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('categories returned', () => pm.expect(body.length).to.be.above(0));",
                  "pm.collectionVariables.set('category_id', body[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/categories/", "host": ["{{base_url}}"], "path": ["api", "categories", ""] }
          }
        },
        {
          "name": "List school levels",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('school_level_id', body[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/school-levels/", "host": ["{{base_url}}"], "path": ["api", "school-levels", ""] }
          }
        },
        {
          "name": "Get CSRF token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('csrf_token', pm.response.json().csrf_token);"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/auth/csrf/", "host": ["{{base_url}}"], "path": ["api", "auth", "csrf", ""] }
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register (new student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('unverified until the code is entered', () => pm.expect(body.email_verified).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.student@example.com\",\n  \"name\": \"Postman Student\",\n  \"password\": \"StrongPass!2026\",\n  \"password_confirm\": \"StrongPass!2026\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register/", "host": ["{{base_url}}"], "path": ["api", "auth", "register", ""] }
          }
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.student@example.com\",\n  \"code\": \"123456\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/verify-email/", "host": ["{{base_url}}"], "path": ["api", "auth", "verify-email", ""] }
          }
        },
        {
          "name": "Resend verification code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.student@example.com\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/resend-verification/", "host": ["{{base_url}}"], "path": ["api", "auth", "resend-verification", ""] }
          }
        },
        {
          "name": "Login (student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('csrf_token', body.csrf_token);",
                  "pm.test('auth cookie set', () => pm.expect(pm.cookies.has('funkies_access')).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@funkies254.test\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api", "auth", "login", ""] }
          }
        },
        {
          "name": "Login (institution staff)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@funkies254.test\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api", "auth", "login", ""] }
          }
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@funkies254.test\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api", "auth", "login", ""] }
          }
        },
        {
          "name": "Login (super admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@funkies254.test\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api", "auth", "login", ""] }
          }
        },
        {
          "name": "Login (wrong password → 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 unauthorised', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@funkies254.test\",\n  \"password\": \"definitely-wrong\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api", "auth", "login", ""] }
          }
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-CSRFToken", "value": "{{csrf_token}}" }],
            "url": { "raw": "{{base_url}}/api/auth/token/refresh/", "host": ["{{base_url}}"], "path": ["api", "auth", "token", "refresh", ""] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-CSRFToken", "value": "{{csrf_token}}" }],
            "url": { "raw": "{{base_url}}/api/auth/logout/", "host": ["{{base_url}}"], "path": ["api", "auth", "logout", ""] }
          }
        }
      ]
    },
